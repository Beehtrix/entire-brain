tdict(int)})","+scanned = matched = 0","+","+for path in glob.glob(os.path.join(ROOT, \"*\", \"*.jsonl\")):","+    try:","+        if os.path.getmtime(path) < cutoff_ts:","+            continue","+    except OSError:","+        continue","+    scanned += 1","+    try:","+        with open(path, \"rb\") as fh:","+            for raw in fh:","+                if not any(m in raw for m in MARKERS):","+                    continue","+                try:","+                    obj = json.loads(raw)","+                except Exception:","+                    continue","+                ts = obj.get(\"timestamp\")","+                if not isinstance(ts, str) or len(ts) < 10:","+                    continue","+                day = ts[:10]","+                msg = obj.get(\"message\") or {}","+                content = msg.get(\"content\")","+                if not isinstance(content, list):","+                    continue","+                for c in content:","+                    if not isinstance(c, dict) or c.get(\"type\") != \"tool_use\":","+                        continue","+                    name = c.get(\"name\") or \"\"","+                    inp = c.get(\"input\") or {}","+                    m = MCP_RE.search(name)","+                    if m:","+                        days[day][\"mcp\"] += 1","+                        days[day][\"tools\"][m.group(1)] += 1","+                        matched += 1","+                    elif name == \"Bash\":","+                        cmd = str(inp.get(\"command\") or \"\")","+                        bm = BASH_RE.search(cmd)","+                        if bm:","+                            days[day][\"bash\"] += 1","+                            days[day][\"tools\"][bm.group(1)] += 1","+                            matched += 1","+    except OSError:","+        continue","+","+out = {","+    \"generated_at\": time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime()),","+    \"window_days\": DAYS,","+    \"files_scanned\": scanned,","+    \"events\": matched,","+    \"days\": {d: {\"mcp\": v[\"mcp\"], \"bash\": v[\"bash\"], \"empty\": v[\"empty\"],","+                 \"tools\": dict(sorted(v[\"tools\"].items(), key=lambda kv: -kv[1]))}","+             for d, v in sorted(days.items())},","+}","+json.dump(out, sys.stdout, indent=1)"]}],"created":true}],"moreFiles":0,"changedFiles":["/Users/suhaan/devenv/.claude/mods/brain-memory/scripts/collect-usage.py"]}},"serverClassifierContext":{"request":"ed113f0d-1b28-44e5-8266-347e60bd3818","context":{"git_state":{"cwd":"/Users/suhaan/devenv","root":"/Users/suhaan/devenv","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":252},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"entirehq/devenv","visibility":"private"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"host":"github.com","remote":"entirehq/entire-api","visibility":"private"}]}},"live_cwd":"/Users/suhaan/devenv","platform":"macos"}},"sourceToolAssistantUUID":"5608597e-c3ab-447c-b608-ac33fdb01b2f","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"1eac9040-9610-45f1-aa43-df0931455a37","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv","sessionId":"6ca2c8fb-c97b-4bf3-a992-0e3c6d1967e2","version":"2.1.296","gitBranch":"main","slug":"dynamic-petting-globe"}
