the brain\",\n  \"branch\": \"main\",\n  \"effective_engine\": \"model2vec_rrf\",\n  \"facts\": [],\n  \"query\": \"anything\",\n  \"retrieval_engine\": {\n    \"schema_version\": 1,\n    \"effective_engine\": \"model2vec_rrf\",\n    \"identity_verified\": true,\n    \"semantic_requested\": true,\n    \"semantic_applied\": true,\n    \"semantic_available\": true,\n    \"bm25_enabled\": false,\n    \"bm25_applied\": false,\n    \"fallback_used\": false,\n    \"requested_embedder\": \"bundled_model2vec\",\n    \"selected_embedder_id\": \"minishlab/potion-retrieval-32M\",\n    \"embedder_id\": \"minishlab/potion-retrieval-32M\",\n    \"embedding_model_id\": \"minishlab/potion-retrieval-32M\",\n    \"embedding_dimension\": 512,\n    \"vector_count\": 953,\n    \"vector_candidate_count\": 953,\n    \"loaded_vector_count\": 953,\n    \"residen\n=== get a nonexistent id ===\n{\n  \"branch\": \"main\",\n  \"missing\": [\n    \"fact:0000000000000000\"\n  ],\n  \"results\": []\n}\n\n=== search ===\n{\n  \"blind_spot\": \"note: facts last distilled 2026-10-03 and all captured sessions are distilled — the answer may genuinely not be in the brain\",\n  \"branch\": \"main\",\n  \"query\": \"zzqqxx\",\n  \"results\": []\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"6c557ef8-3b5c-4139-86d7-448f2917c9ba","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-installed","root":null,"branch":null,"default_branch":null,"status":null,"visibility":null,"error":"pending"},"live_cwd":"/Users/suhaan/devenv/brain-installed","platform":"macos"}},"sourceToolAssistantUUID":"36f912a2-df4d-48f2-87d2-fd935e8fd388","session_id":"6ca2c8fb-c97b-4bf3-a992-0e3c6d1967e2","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/brain-installed","sessionId":"6ca2c8fb-c97b-4bf3-a992-0e3c6d1967e2","version":"2.1.288","gitBranch":"main","slug":"dynamic-petting-globe"}
