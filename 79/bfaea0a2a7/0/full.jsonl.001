POINT -- and nothing naming the edited file. The flag","+// expanded to \"\" on every edit, so the hook errored every time and served","+// nothing. It was installed and inert, which is the worst of both.","+func TestHookReadsTheFilePathFromTheHarnessPayload(t *testing.T) {","+\tt.Parallel()","+","+\t// The exact shape captured from Claude Code 2.1.288.","+\tconst real = `{\"session_id\":\"20373dcb\",\"transcript_path\":\"/x/y.jsonl\",","+\t  \"cwd\":\"/repo\",\"permission_mode\":\"bypassPermissions\",","+\t  \"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Write\",","+\t  \"tool_input\":{\"file_path\":\"/repo/internal/cli/semantic.go\",\"content\":\"x\"},","+\t  \"tool_use_id\":\"toolu_01\"}`","+","+\tif got := hookFileFromStdin(strings.NewReader(real)); got != \"/repo/internal/cli/semantic.go\" {","+\t\tt.Fatalf(\"file path from the real payload = %q, want the tool_input.file_path\", got)","+\t}","+}","+","+// NotebookEdit names its target notebook_path, not file_path. The installed","+// matcher includes NotebookEdit, so ignoring it would leave that tool wired to","+// a hook that can never resolve a path.","+func TestHookReadsNotebookPathToo(t *testing.T) {","+\tt.Parallel()","+","+\tconst nb = `{\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"NotebookEdit\",","+\t  \"tool_input\":{\"notebook_path\":\"/repo/analysis.ipynb\"}}`","+","+\tif got := hookFileFromStdin(strings.NewReader(nb)); got != \"/repo/analysis.ipynb\" {","+\t\tt.Fatalf(\"notebook path = %q, want tool_input.notebook_path\", got)","+\t}","+}","+","+// Every malformed input is silence, never an error. A hook that fails breaks","+// the harness it is wired into, and an edit must never be blocked because the","+// brain could not parse something.","+func TestHookPayloadFailuresAreSilent(t *testing.T) {","+\tt.Parallel()","+","+\tfor name, in := range map[string]string{","+\t\t\"empty\":            \"\",","+\t\t\"not json\":         \"this is not json at all\",","+\t\t\"json but no tool\": `{\"hook_event_name\":\"PreToolUse\"}`,","+\t\t\"empty file_path\":  `{\"tool_input\":{\"file_path\":\"   \"}}`,","+\t\t\"wrong types\":      `{\"tool_input\":{\"file_path\":123}}`,","+\t\t\"truncated\":        `{\"tool_input\":{\"file_path\":\"/a/b.go\"`,","+\t} {","+\t\tt.Run(name, func(t *testing.T) {","+\t\t\tif got := hookFileFromStdin(strings.NewReader(in)); got != \"\" {","+\t\t\t\tt.Fatalf(\"want silence for %s, got %q\", name, got)","+\t\t\t}","+\t\t})","+\t}","+\tif got := hookFileFromStdin(nil); got != \"\" {","+\t\tt.Fatalf(\"a nil reader must be silence, got %q\", got)","+\t}","+}","+","+// The wiring must not pass a variable the harness does not define. A path that","+// expands to \"\" is indistinguishable from a working hook until someone checks","+// whether a fact was ever served.","+func TestInstalledWiringDoesNotReferenceANonexistentVariable(t *testing.T) {","+\tt.Parallel()","+","+\troot := t.TempDir()","+\tif _, err := MergePreEditHookForTest(root, \"entire brain\"); err != nil {","+\t\tt.Fatalf(\"merge: %v\", err)","+\t}","+\twiring := readSettingsForTest(t, root)","+\tif strings.Contains(wiring, \"CLAUDE_FILE_PATH\") {","+\t\tt.Error(\"the wiring passes $CLAUDE_FILE_PATH, which Claude Code does not define; \" +","+\t\t\t\"it expands to \\\"\\\" and the hook serves nothing on every edit\")","+\t}","+\tif !strings.Contains(wiring, \"hook pre-edit\") {","+\t\tt.Fatalf(\"the pre-edit hook is not wired at all:\\n%s\", wiring)","+\t}","+}"]}],"created":true}],"moreFiles":0,"changedFiles":["/Users/suhaan/devenv/brain-v1-guide/internal/cli/hook_payload_helper_test.go","/Users/suhaan/devenv/brain-v1-guide/internal/cli/hook_payload_test.go"]}},"serverClassifierContext":{"request":"2fd2476e-472e-4f92-971c-c82bc1cf8367","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-v1-guide","root":"/Users/suhaan/devenv/brain-v1-guide","branch":"fix/agent-guide-directive-and-discovery","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":