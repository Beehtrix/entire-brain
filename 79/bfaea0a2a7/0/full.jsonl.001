ontract) of the current working tree against brain memory, not a branch/base diff. Returns severity-ranked suspected regressions with provenance. Use instead of re-reading your own changes to catch a silently reverted decision. Not for style, build errors or anything memory never recorded — read the diff for those.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"include_deletions\":{\"description\":\"Also flag deleted assignments (lower confidence, noisier)\",\"title\":\"include_deletions\",\"type\":\"boolean\"},\"limit\":{\"description\":\"Maximum findings (removable rows may be trimmed with response_truncated; otherwise errors)\",\"maximum\":10000,\"minimum\":1,\"title\":\"limit\",\"type\":\"integer\"},\"location_only\":{\"description\":\"Return only the suspected file:line, not the expected/current values\",\"title\":\"location_only\",\"type\":\"boolean\"},\"query\":{\"description\":\"What to review plus the relevant symbols/identifiers\",\"maxLength\":8192,\"title\":\"query\",\"type\":\"string\"}},\"required\":[\"query\"],\"type\":\"object\"},\"name\":\"brain_review\"}"]}]},{"filePath":"/Users/suhaan/devenv/brain-v1-guide/internal/cli/testdata/mcp_brain_workspace_review_tool.golden.json","hunks":[{"oldStart":1,"oldLines":1,"newStart":1,"newLines":1,"lines":["-{\"description\":\"Cross-repo diff-less review (versioned contract) of each local workspace repo's current tree against its brain memory, severity-ranked per repo. Use instead of re-reading your changes in each sibling checkout. Not for style or build errors, and not for repos outside the workspace — registered siblings are allowed when the bound repo is a member; other workspaces need ENTIRE_BRAIN_MCP_ALLOW_CROSS_REPO.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"include_deletions\":{\"description\":\"Also flag deleted assignments (lower confidence, noisier)\",\"title\":\"include_deletions\",\"type\":\"boolean\"},\"limit\":{\"description\":\"Maximum findings per repo (removable rows may be trimmed with response_truncated; otherwise errors)\",\"maximum\":10000,\"minimum\":1,\"title\":\"limit\",\"type\":\"integer\"},\"location_only\":{\"description\":\"Return only the suspected file:line, not the expected/current values\",\"title\":\"location_only\",\"type\":\"boolean\"},\"query\":{\"description\":\"What to review plus the relevant symbols/identifiers\",\"maxLength\":8192,\"title\":\"query\",\"type\":\"string\"},\"workspace\":{\"description\":\"Workspace name\",\"maxLength\":8192,\"title\":\"workspace\",\"type\":\"string\"}},\"required\":[\"workspace\",\"query\"],\"type\":\"object\"},\"name\":\"brain_workspace_review\"}","+{\"description\":\"Cross-repo diff-less review (versioned contract) of each local workspace repo's current tree against its brain memory, severity-ranked per repo. Use instead of re-reading your changes in each sibling checkout. Not for style or build errors, and not for repos outside the workspace — registered siblings are allowed when the bound repo is a member; other workspaces need ENTIRE_BRAIN_MCP_ALLOW_CROSS_REPO.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"include_deletions\":{\"description\":\"Also flag deleted assignments (lower confidence, noisier)\",\"title\":\"include_deletions\",\"type\":\"boolean\"},\"limit\":{\"description\":\"Maximum findings per repo (removable rows may be trimmed with response_truncated; otherwise errors)\",\"maximum\":10000,\"minimum\":1,\"title\":\"limit\",\"type\":\"integer\"},\"location_only\":{\"description\":\"Return only the suspected file:line, not the expected/current values\",\"title\":\"location_only\",\"type\":\"boolean\"},\"query\":{\"description\":\"What to review plus the relevant symbols/identifiers\",\"maxLength\":8192,\"title\":\"query\",\"type\":\"string\"},\"workspace\":{\"description\":\"Workspace name\",\"maxLength\":8192,\"title\":\"workspace\",\"type\":\"string\"}},\"required\":[\"workspace\",\"query\"],\"type\":\"object\"},\"