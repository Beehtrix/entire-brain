]bool{\"ollama\": true, \"codex\": true, \"claude\": true}}","+\tif got := defaultRefreshAgent(ctx, all, t.TempDir()); got == \"ollama\" {","+\t\tt.Error(\"auto must not choose ollama: it cannot supply the --model ollama requires\")","+\t}","+","+\t// It still chooses a working agent rather than giving up.","+\tif got := defaultRefreshAgent(ctx, all, t.TempDir()); got != \"codex\" {","+\t\tt.Errorf(\"auto should fall through to the next usable agent, got %q\", got)","+\t}","+\tonlyClaude := fakeWhichRunner{present: map[string]bool{\"ollama\": true, \"claude\": true}}","+\tif got := defaultRefreshAgent(ctx, onlyClaude, t.TempDir()); got != \"claude-code\" {","+\t\tt.Errorf(\"with only claude beside ollama, want claude-code, got %q\", got)","+\t}","+\t// Nothing usable is still \"none\", not ollama.","+\tonlyOllama := fakeWhichRunner{present: map[string]bool{\"ollama\": true}}","+\tif got := defaultRefreshAgent(ctx, onlyOllama, t.TempDir()); got != \"none\" {","+\t\tt.Errorf(\"ollama alone cannot distill automatically, want none, got %q\", got)","+\t}","+}","+","+// Falling through must not be silent: a user who installed ollama for privacy","+// needs to know a cloud agent ran instead, and how to get the local one.","+func TestFallingBackFromOllamaIsDisclosed(t *testing.T) {","+\tt.Parallel()","+","+\tctx := context.Background()","+\tall := fakeWhichRunner{present: map[string]bool{\"ollama\": true, \"codex\": true}}","+","+\twarn := ollamaModelMissingWarning(ctx, all, t.TempDir(), \"codex\")","+\tfor _, want := range []string{\"ollama\", \"--model\", \"codex\"} {","+\t\tif !strings.Contains(warn, want) {","+\t\t\tt.Errorf(\"the warning must mention %q: %q\", want, warn)","+\t\t}","+\t}","+","+\t// No warning when ollama was actually used, when nothing ran, or when","+\t// ollama is not installed at all -- otherwise it is noise.","+\tif got := ollamaModelMissingWarning(ctx, all, t.TempDir(), \"ollama\"); got != \"\" {","+\t\tt.Errorf(\"no warning when ollama was chosen: %q\", got)","+\t}","+\tif got := ollamaModelMissingWarning(ctx, all, t.TempDir(), \"none\"); got != \"\" {","+\t\tt.Errorf(\"no warning when no agent ran: %q\", got)","+\t}","+\tnoOllama := fakeWhichRunner{present: map[string]bool{\"codex\": true}}","+\tif got := ollamaModelMissingWarning(ctx, noOllama, t.TempDir(), \"codex\"); got != \"\" {","+\t\tt.Errorf(\"no warning when ollama is not installed: %q\", got)","+\t}","+}"]}],"created":true}],"moreFiles":0,"changedFiles":["/Users/suhaan/devenv/brain-v1-guide/internal/cli/refresh_ollama_auto_test.go"]}},"serverClassifierContext":{"request":"f267e0b7-42ec-4de9-8649-07bde5437001","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-v1-guide","root":"/Users/suhaan/devenv/brain-v1-guide","branch":"fix/agent-guide-directive-and-discovery","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":2,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},"push_remote":"origin","remotes":[{"name":"entireio","host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"name":"origin","host":"github.com","remote":"entireio/entire-brain","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"host":"github.com","remote":"entireio/entire-graph","visibility":"public"},{"host":"github.com","remote":"entirehq/entiredb","visibility":"private"},{"host":"github.com","remote":"entireio/cli","visibility":"public"}]}},"live_cwd":"/Users/suhaan/devenv/brain-v1-guide","platform":"macos"}},"sourceToolAssistantUUID":"fd334598-9efb-426f-813c-4c02fa89d703","session_id":"6ca2c8fb-c97b-4bf3-a992-0e3c6d1967e2","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/brain-v1-guide","sessionId":"6ca2c8fb-c97b-4bf3-a992