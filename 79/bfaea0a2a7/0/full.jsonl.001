d commit them together when the instructions should apply to your team. Restart your agent or reload its repository instructions so it picks up the guide."," "," For an MCP client, print this repository's configuration:"," "]}]},{"filePath":"/Users/suhaan/devenv/brain-v1-guide/internal/agentsetup/coordination_test.go","hunks":[{"oldStart":411,"oldLines":3,"newStart":411,"newLines":48,"lines":[" \t\t}"," \t}"," }","+","+// A Brain-only activation produces a guide with NO Graph instruction, because","+// activation is recorded in the guide rather than probed from the installed","+// plugins (preview.go: \"activation does not depend on plugin inventory\").","+//","+// Measured in a clean clone: `entire brain init-agents` alone yields","+// `enabled:[\"brain\"]` and zero occurrences of the Graph directive. So the","+// directive restored for the combined guide is unreachable for anyone who","+// follows Brain's README without also activating Graph — which is why the","+// README now names both commands and their order.","+func TestBrainOnlyActivationHasNoGraphInstruction(t *testing.T) {","+\tbrainOnly := BrainGuide()","+\tfor _, graphism := range []string{\"MUST be ONE Graph search\", \"entire graph search\", \"entire graph query\"} {","+\t\tif strings.Contains(brainOnly, graphism) {","+\t\t\tt.Errorf(\"the Brain-only guide names %q; it must not instruct an agent to use a product that was never activated\", graphism)","+\t\t}","+\t}","+\t// ...and the combined guide must, or the directive reaches nobody.","+\tif !strings.Contains(CombinedGuide, \"MUST be ONE Graph search\") {","+\t\tt.Error(\"the combined guide lost the Graph directive; only the combined guide can carry it\")","+\t}","+}","+","+// The README must name both activation commands and their order. Brain's","+// documented path produced a guide with no Graph instruction, so an agent could","+// not have followed one.","+func TestREADMEDocumentsBothActivationsAndTheirOrder(t *testing.T) {","+\tdata, err := os.ReadFile(\"../../README.md\")","+\tif err != nil {","+\t\tt.Fatalf(\"read README: %v\", err)","+\t}","+\treadme := string(data)","+\tif len(readme) == 0 {","+\t\tt.Fatal(\"README is empty; this assertion would be vacuous\")","+\t}","+\tfor _, want := range []string{\"entire graph init-agents\", \"entire brain init-agents\"} {","+\t\tif !strings.Contains(readme, want) {","+\t\t\tt.Errorf(\"README does not tell the user to run %q\", want)","+\t\t}","+\t}","+\tif !strings.Contains(readme, \"last\") {","+\t\tt.Error(\"README does not state the activation ORDER; each product rewrites the guide from its own text, \" +","+\t\t\t\"so the one run last decides the wording\")","+\t}","+}"]}]}],"moreFiles":0,"changedFiles":["/Users/suhaan/devenv/brain-v1-guide/README.md","/Users/suhaan/devenv/brain-v1-guide/internal/agentsetup/coordination_test.go"]}},"serverClassifierContext":{"request":"92f76466-6ddc-4876-be6f-77543f25765f","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-v1-guide","root":"/Users/suhaan/devenv/brain-v1-guide","branch":"fix/agent-guide-directive-and-discovery","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":3,"untracked":null,"untracked_normal":2},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},"push_remote":"origin","remotes":[{"name":"entireio","host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"name":"origin","host":"github.com","remote":"entireio/entire-brain","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"host":"github.com","remote":"entireio/entire-graph","visibility":"public"},{"host":"github.com","remote":"entirehq/entiredb","visibility":"private"}]}},"live_cwd":"/Users/suhaan/devenv/brain-v1-guide","platform":"macos"}},"sourceToolAssistantUUID":"30bce4f9