p) or os.path.getsize(p) == 0: continue\n        try: d = json.load(open(p))\n        except Exception: continue\n        res = d.get(\"result\") or \"\"\n        ok = 1 if truth[i] in res else 0\n        solved.append(ok); per_task[i] = ok\n        turns.append(d.get(\"num_turns\") or 0)\n        cost.append(float(d.get(\"total_cost_usd\") or 0) * 100)\n        mu = d.get(\"modelUsage\") or {}\n        t = 0\n        for v in mu.values():\n            if isinstance(v, dict):\n                t += (v.get(\"inputTokens\") or 0) + (v.get(\"outputTokens\") or 0) \\\n                   + (v.get(\"cacheReadInputTokens\") or 0) + (v.get(\"cacheCreationInputTokens\") or 0)\n        toks.append(t)\n    rows[arm] = (solved, turns, cost, toks, per_task)\n\nprint(f\"{\"arm\":<4} {\"n\":>2}  {\"solved\":<24} {\"turns\":<22} {\"cost (cents)\":<22} {\"tokens\":<22}\")\nfor arm, (s, tu, c, tk, _) in rows.items():\n    print(f\"{arm:<4} {len(s):>2}  {cell(s,True):<24} {cell(tu):<22} {cell(c):<22} {cell(tk):<22}\")\n\nprint()\nprint(\"per-task solved (1=named the right file), paired across arms:\")\nprint(\"  task  \" + \"  \".join(f\"{a:>3}\" for a in rows))\ncommon = set.intersection(*[set(r[4]) for r in rows.values()]) if all(r[4] for r in rows.values()) else set()\nfor i in range(1, 11):\n    marks = \"  \".join(f\"{rows[a][4].get(i,'-'):>3}\" for a in rows)\n    star = \"\" if i in common else \"   (dropped: not in every arm)\"\n    print(f\"  {i:<5} {marks}{star}\")\nprint(f\"\\\\npaired tasks present in all arms: {len(common)}  -> {sorted(common)}\")\n''')\nWRAP\npython3 \"$E/outcome.py\" 2>&1 | head -30","description":"Score outcome, turns, cost and tokens per arm","timeout":900000}},"serverClassifierRequest":"844545da-a18b-4dc6-b716-e19fef1a2ed5","apiBlockIndex":0,"requestId":"req_011CffT7aU79BSqzFJ25gGUw","type":"assistant","uuid":"58b6640a-f459-41de-8ad0-0b573efe0712","timestamp":"2026-10-03T14:20:43.834Z","advisorModel":"claude-opus-5-5","effort":"xhigh","perTurnEffort":