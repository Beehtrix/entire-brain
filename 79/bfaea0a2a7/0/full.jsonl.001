orBriefTest(t, brainDir, \"feat/dead\", []factRecord{","+\t\t{ID: \"fact:d1\", Branch: \"feat/dead\", Status: factStatusRetracted, Text: \"retired\"},","+\t\t{ID: \"fact:d2\", Branch: \"feat/dead\", Status: factStatusSuperseded, Text: \"replaced\"},","+\t})","+\twriteFactsForBriefTest(t, brainDir, \"feat/live\", []factRecord{","+\t\t{ID: \"fact:l1\", Branch: \"feat/live\", Status: factStatusActive, Text: \"a live decision\"},","+\t})","+","+\tnote := briefBranchBlindSpot(brainDir, \"main\")","+\tif note == \"\" {","+\t\tt.Fatal(\"a branch holding a live fact must still produce a note\")","+\t}","+\tif strings.Contains(note, \"feat/dead\") {","+\t\tt.Errorf(\"a branch holding only retracted or superseded facts is a false lead:\\n%s\", note)","+\t}","+\tif !strings.Contains(note, \"feat/live\") {","+\t\tt.Errorf(\"the branch holding a live fact must be named:\\n%s\", note)","+\t}","+","+\t// And with nothing live anywhere, there is nothing to say.","+\tbare := writeDistillFixture(t, now)","+\twriteFactsForBriefTest(t, bare, \"feat/dead\", []factRecord{","+\t\t{ID: \"fact:d1\", Branch: \"feat/dead\", Status: factStatusRetracted, Text: \"retired\"},","+\t})","+\tif note := briefBranchBlindSpot(bare, \"main\"); note != \"\" {","+\t\tt.Errorf(\"no live facts anywhere means no remedy to offer, got %q\", note)","+\t}","+}","+","+func writeFactsForBriefTest(t *testing.T, brainDir, branch string, records []factRecord) {","+\tt.Helper()","+\tif err := writeFacts(brainDir, branch, records); err != nil {","+\t\tt.Fatalf(\"write facts on %s: %v\", branch, err)","+\t}","+}"]}],"created":true}],"moreFiles":0,"changedFiles":["/Users/suhaan/devenv/brain-v1-guide/internal/cli/blind_spot_brief_test.go"]}},"serverClassifierContext":{"request":"1bb7181b-ac3b-411f-b235-4edcd29385c8","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-v1-guide","root":"/Users/suhaan/devenv/brain-v1-guide","branch":"fix/agent-guide-directive-and-discovery","default_branch":"main","status":{"clean":fal