ckground(), &availabilityRunner{present: present}, t.TempDir())\ninternal/cli/local_agent_preference_test.go-44-\t\t\tif got != tc.want {\ninternal/cli/local_agent_preference_test.go-45-\t\t\t\tt.Fatalf(\"with %v installed, chose %q, want %q\", tc.present, got, tc.want)\ninternal/cli/local_agent_preference_test.go-46-\t\t\t}\ninternal/cli/local_agent_preference_test.go-47-\t\t})\ninternal/cli/local_agent_preference_test.go-48-\t}\ninternal/cli/local_agent_preference_test.go-49-}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"508ff97b-864a-4141-812a-829a43b931c1","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-v1-guide","root":"/Users/suhaan/devenv/brain-v1-guide","branch":"fix/agent-guide-directive-and-discovery","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":2,"untracked":null,"untracked_normal":2},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},"push_remote":"origin","remotes":[{"name":"entireio","host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"name":"origin","host":"github.com","remote":"entireio/entire-brain","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"host":"github.com","remote":"entireio/entire-graph","visibility":"public"},{"host":"github.com","remote":"entirehq/entiredb","visibility":"private"},{"host":"github.com","remote":"entireio/cli","visibility":"public"}]}},"live_cwd":"/Users/suhaan/devenv/brain-v1-guide","platform":"macos"}},"sourceToolAssistantUUID":"160be3a4-c377-4484-84ab-c22a2d1841ce","session_id":"6ca2c8fb-c97b-4bf3-a992-0e3c6d1967e2","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/brain-v1-guide","sessionId":"6ca2c8fb-c97b-4bf3-a992-0e