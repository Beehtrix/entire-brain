e\":\"PreToolUse\",\"tool_name\":\"NotebookEdit\",\n47\t\t  \"tool_input\":{\"notebook_path\":\"/repo/analysis.ipynb\"}}`\n48\t\n49\t\tif got, saw := hookFileFromStdin(strings.NewReader(nb)); got != \"/repo/analysis.ipynb\" || !saw {\n50\t\t\tt.Fatalf(\"notebook path = %q (saw=%v), want tool_input.notebook_path\", got, saw)\n51\t\t}\n52\t}\n53\t\n54\t// Malformed input is silence, never an error, and must still report sawInput so\n55\t// the command exits 0. This runs on every edit; a hook that errors on every\n56\t// edit gets deleted from the settings within a day.\n57\tfunc TestHookPayloadFailuresAreSilent(t *testing.T) {\n58\t\tt.Parallel()\n59\t\n60\t\tfor name, in := range map[string]string{\n61\t\t\t\"not json\":         \"this is not json at all\",\n62\t\t\t\"json but no tool\": `{\"hook_event_name\":\"PreToolUse\"}`,\n63\t\t\t\"empty file_path\":  `{\"tool_input\":{\"file_path\":\"   \"}}`,\n64\t\t\t\"wrong types\":      `{\"tool_input\":{\"file_path\":123}}`,\n65\t\t\t\"truncated\":        `{\"tool_input\":{\"file_path\":\"/a/b.go\"`,\n66\t\t} {\n67\t\t\tt.Run(name, func(t *testing.T) {\n68\t\t\t\tgot, saw := hookFileFromStdin(strings.NewReader(in))\n69\t\t\t\tif got != \"\" {\n70\t\t\t\t\tt.Fatalf(\"want no path for %s, got %q\", name, got)\n71\t\t\t\t}\n72\t\t\t\tif !saw {\n73\t\t\t\t\tt.Errorf(\"%s: stdin had bytes but sawInput=false, so the command would error on every edit\", name)\n74\t\t\t\t}\n75\t\t\t})\n76\t\t}\n77\t\t// Genuinely nothing: no bytes, and no claim that a harness called us.\n78\t\tfor name, in := range map[string]string{\"empty\": \"\", \"whitespace\": \"  \\n\\t \"} {\n79\t\t\tt.Run(name, func(t *testing.T) {\n80\t\t\t\tif got, saw := hookFileFromStdin(strings.NewReader(in)); got != \"\" || saw {\n81\t\t\t\t\tt.Fatalf(\"%s must be (\\\"\\\", false), got (%q, %v)\", name, got, saw)\n82\t\t\t\t}\n83\t\t\t})\n84\t\t}\n85\t\tif got, saw := hookFileFromStdin(nil); got != \"\" || saw {\n86\t\t\tt.Fatalf(\"a nil reader must be (\\\"\\\", false), got (%q, %v)\", got, saw)\n87\t\t}\n88\t}\n89\t\n90\t// The wiring must not reference a variable the harness does not define. A path\n91\t// that expands to \"\" is indistinguishable from a working hook until someone\n92\t// checks whether a fact was ever served.\n93\tfunc TestInstalledWiringDoesNotReferenceANonexistentVariable(t *testing.T) {\n94\t\tt.Parallel()\n95\t\n96\t\troot := t.TempDir()\n97\t\tif _, err := MergePreEditHookForTest(root, \"entire brain\"); err != nil {\n98\t\t\tt.Fatalf(\"merge: %v\", err)\n99\t\t}\n100\t\twiring := readSettingsForTest(t, root)\n101\t\tif strings.Contains(wiring, \"CLAUDE_FILE_PATH\") {\n102\t\t\tt.Error(\"the wiring passes $CLAUDE_FILE_PATH, which Claude Code does not define; \" +\n103\t\t\t\t\"it expands to \\\"\\\" and the hook serves nothing on every edit\")\n104\t\t}\n105\t\tif !strings.Contains(wiring, \"hook pre-edit\") {\n106\t\t\tt.Fatalf(\"the pre-edit hook is not wired at all:\\n%s\", wiring)\n107\t\t}\n108\t}\n109\t\n110\t// END-TO-END. The helper tests above all stayed green when the CALL SITE was\n111\t// neutered, which is the defect class where the bug lives in the wiring between\n112\t// two correct functions rather than in either of them.\n113\t//\n114\t// This drives the real command over a real brain holding a real fact, with the\n115\t// path delivered the way a harness delivers it: JSON on stdin, no --file.\n116\tfunc TestPreEditServesFactsFromAHarnessPayloadOnStdin(t *testing.T) {\n117\t\tf := newVerifyFixture(t)\n118\t\tfact := vitalityTestFact(\"internal/cli/distill_cmd.go owns the distill flag surface.\", \"main\", f.now)\n119\t\tif err := writeFacts(f.brainDir, \"main\", []factRecord{fact}); err != nil {\n120\t\t\tt.Fatalf(\"write facts: %v\", err)\n121\t\t}\n122\t\n123\t\tpayload := `{\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Edit\",` +\n124\t\t\t`\"tool_input\":{\"file_path\":\"internal/cli/distill_cmd.go\"}}`\n125\t\n126\t\tvar out bytes.Buffer\n127\t\tcmd := NewRootCommand(f.opts