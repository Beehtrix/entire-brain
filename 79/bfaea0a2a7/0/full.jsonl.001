","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/brain-v1-guide","sessionId":"6ca2c8fb-c97b-4bf3-a992-0e3c6d1967e2","version":"2.1.288","gitBranch":"main","slug":"dynamic-petting-globe"}
