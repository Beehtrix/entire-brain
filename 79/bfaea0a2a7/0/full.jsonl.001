REMOTE_BASH_TOOL\nmcp__claude_ai_composio__COMPOSIO_REMOTE_WORKBENCH\nmcp__claude_ai_composio__COMPOSIO_SEARCH_SKILLS\nmcp__claude_ai_composio__COMPOSIO_SEARCH_TOOLS\nmcp__claude_ai_composio__COMPOSIO_SUBMIT_FEEDBACK\nmcp__claude_ai_composio__COMPOSIO_USE_SKILL\nmcp__claude_ai_composio__COMPOSIO_WAIT_FOR_CONNECTIONS\nmcp__context7__query-docs\nmcp__context7__resolve-library-id\nmcp__entire-brain__brain_boundaries\nmcp__entire-brain__brain_brief\nmcp__entire-brain__brain_changes\nmcp__entire-brain__brain_code\nmcp__entire-brain__brain_context\nmcp__entire-brain__brain_dead_code\nmcp__entire-brain__brain_delete_project\nmcp__entire-brain__brain_detect_changes\nmcp__entire-brain__brain_entity_history\nmcp__entire-brain__brain_get\nmcp__entire-brain__brain_get_architecture\nmcp__entire-brain__brain_get_code_snippet\nmcp__entire-brain__brain_get_graph_schema\nmcp__entire-brain__brain_impact\nmcp__entire-brain__brain_index_repository\nmcp__entire-brain__brain_index_status\nmcp__entire-brain__brain_ingest_traces\nmcp__entire-brain__brain_list_projects\nmcp__entire-brain__brain_multi_get\nmcp__entire-brain__brain_patterns\nmcp__entire-brain__brain_patterns_status\nmcp__entire-brain__brain_query\nmcp__entire-brain__brain_query_graph\nmcp__entire-brain__brain_refresh\nmcp__entire-brain__brain_regressions\nmcp__entire-brain__brain_review\nmcp__entire-brain__brain_search\nmcp__entire-brain__brain_search_code\nmcp__entire-brain__brain_search_graph\nmcp__entire-brain__brain_status\nmcp__entire-brain__brain_tests\nmcp__entire-brain__brain_trace_path\nmcp__entire-brain__brain_vsearch\nmcp__entire-brain__brain_workspace_graph\nmcp__entire-brain__brain_workspace_regressions\nmcp__entire-brain__brain_workspace_review\nmcp__plugin_bio-research_biorender__authenticate\nmcp__plugin_bio-research_biorender__complete_authentication\nmcp__plugin_bio-research_biorxiv__get_categories\nmcp__plugin_bio-research_biorxiv__get_content_statistics\nmcp__plugin_bio-research_biorxiv__get_preprint\nmcp_