mmediately above. verifySemanticWorktreeStable has already confirmed","-\t\t// the tree did not move while the provider ran, so the snapshot","-\t\t// describes exactly the commit brain resolved. Without that the stamp","-\t\t// would be an assertion about a tree that might have changed, which is","-\t\t// why this sits after it and not earlier.","-\t\tif stamped := stampSemanticHeaderFromLocalGit(&header, head, tree); stamped != \"\" {","+\t\t// The provider could not stamp its own provenance, and brain supplied","+\t\t// it during the stream scan (see semanticStreamScanConfig.commit).","+\t\t// Disclosed rather than silent: the snapshot's commit came from brain's","+\t\t// own git, not from the thing that did the indexing.","+\t\tif res.stampedHeader != \"\" {"," \t\t\twarnings = append(warnings, semanticWarning{"," \t\t\t\tCode:     \"provider_header_stamped_locally\","," \t\t\t\tSeverity: \"warning\","," \t\t\t\tEffect:   \"provenance supplied by brain\",","-\t\t\t\tDetail:   stamped,","+\t\t\t\tDetail:   res.stampedHeader,"," \t\t\t})"," \t\t}"," \t\tif err := validateLiveSemanticHeader(header, head, tree, indexOpts.worktree && dirty); err != nil {"]}]}],"moreFiles":0,"changedFiles":["/Users/suhaan/devenv/brain-v1-guide/internal/cli/semantic.go"]}},"serverClassifierContext":{"request":"db1572ed-719f-4e3e-a4d7-a0310d96d796","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-v1-guide","root":"/Users/suhaan/devenv/brain-v1-guide","branch":"fix/agent-guide-directive-and-discovery","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":2,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},"push_remote":"origin","remotes":[{"name":"entireio","host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"name":"origin","host":"github.com","remote":"entireio/entire-brain","visibility":"public"}],"visib