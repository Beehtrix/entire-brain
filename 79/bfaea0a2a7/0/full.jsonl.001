binedWorkflow = brainWorkflow + `\nBoth tools run, in this order, and neither replaces the other:\n\n    1. entire brain brief \"<task>\" --json                      (why, and what was decided)\n    2. entire graph search --repo . --profile full --query \"<task>\"   (where, and what depends on it)\n\nStep 2 holds for small edits, follow-up work, and tasks that already name the\nfile: a named file answers where code is, not what else depends on it. Do not\nskip either step on the grounds that the available context feels sufficient, and\ndo not treat having done one as having done the other.\nUse Graph search, def, neighbors, and impact for code discovery and structural\nanalysis.'''\nassert s.count(old)==1\nopen(p,'w').write(s.replace(old,new)); print(\"combined guide now states a sequence\")\nPY\ngofmt -w internal/agentsetup/guide.go && go build ./... 2>&1|head -3\necho \"=== both steps present, exactly once each, in the combined guide? ===\"\n\"$PWD/../../.claude/jobs/6ca2c8fb/tmp/cleanenv/bin/entire-brain-pinned\" version >/dev/null 2>&1\ngo run ./cmd/entire-brain agent-guide --normal --repo . 2>/dev/null | grep -nE \"entire brain brief|entire graph search|MUST be ONE\" | head -5","description":"Fix the competing first-action directives","timeout":1200000}},"serverClassifierRequest":"ec66c4a8-3805-4291-8a0f-666fda615771","apiBlockIndex":1,"requestId":"req_011CffTFUMV9tJQJahXzm1Bc","type":"assistant","uuid":"f14b8967-d992-4c93-b340-514068dfd4b6","timestamp":"2026-10-03T14:22:29.206Z","advisorModel":"claude-opus-5-5","effort":"xhigh","perTurnEffort":null,"session_id":"6ca2c8fb-c97b-4bf3-a992-0e3c6d1967e2","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv","sessionId":"6ca2c8fb-c97b-4bf3-a992-0e3c6d1967e2","version":"2.1.288","gitBranch":"main","slug":"dynamic-petting-globe"}
