h no Graph instructions in it, even when Graph is installed","-— so run Graph's `init-agents` too if you want both. Run Brain's **last**: each","-product rewrites the shared guide file from its own copy of the text, so the one","-you run last decides the wording.","-","-sh","+```sh"," entire brain mcp --print-config"," ```"," "]}]}],"moreFiles":0,"changedFiles":["/Users/suhaan/devenv/brain-v1-guide/README.md"]}},"serverClassifierContext":{"request":"d6f78d11-02ca-419e-b6f0-a6df8f2aac0d","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-v1-guide","root":"/Users/suhaan/devenv/brain-v1-guide","branch":"fix/agent-guide-directive-and-discovery","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":3,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},"push_remote":"origin","remotes":[{"name":"entireio","host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"name":"origin","host":"github.com","remote":"entireio/entire-brain","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"host":"github.com","remote":"entireio/entire-graph","visibility":"public"},{"host":"github.com","remote":"entirehq/entiredb","visibility":"private"},{"host":"github.com","remote":"entireio/cli","visibility":"public"}]}},"live_cwd":"/Users/suhaan/devenv/brain-v1-guide","platform":"macos"}},"sourceToolAssistantUUID":"b4fb3c0d-8952-4cfd-a42f-324ca08e60fa","session_id":"6ca2c8fb-c97b-4bf3-a992-0e3c6d1967e2","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/brain-v1-guide","sessionId":"6ca2c8fb-c97b-4bf3-a992-0e3c6d1967e2","version":"2.1.288","gitBranch":"main","slug":"dynamic-petting-globe"}
