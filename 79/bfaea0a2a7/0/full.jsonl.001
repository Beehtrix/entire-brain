alse","+\t// Contention is decided before the agent is: see above."," \terr = withDistillPassLock(storage.BrainDir, func() {"," \t\tskipped = true"," \t\t// Tell the CALLER, not just the terminal. A skipped pass spends"]},{"oldStart":760,"oldLines":6,"newStart":764,"newLines":15,"lines":[" \t\t\t\"distill: another distill pass already holds %s for this brain; skipping so the same sessions are not distilled twice\\n\","," \t\t\tfilepath.Join(storage.BrainDir, brainLockDirName, brainDistillLockName))"," \t}, func() error {","+\t\t// We hold the lock, so this pass will really run: NOW the agent has to","+\t\t// exist. ollama is named because it is auto-selected ahead of the","+\t\t// cloud agents (issue #328); the old text listed only codex and","+\t\t// claude-code, so a user whose local model was missing was told to","+\t\t// install something else entirely.","+\t\tif distillOpts.agent == \"none\" {","+\t\t\treturn errors.New(\"distillation requires an agent (ollama, codex, or claude-code); none found on PATH\")","+\t\t}","+"," \t\t// Built once per run, before any agent call: reading the derived index"," \t\t// is cheap and bounded, and a missing/empty index yields nil, which"," \t\t// restores the pre-index anchoring exactly. Built INSIDE the pass lock"]}]}],"moreFiles":0,"changedFiles":["/Users/suhaan/devenv/brain-v1-safety/internal/cli/distill_cmd.go"]}},"serverClassifierContext":{"request":"4c72ea20-02fa-4d6c-85eb-6f288cb05e26","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-v1-safety","root":"/Users/suhaan/devenv/brain-v1-safety","branch":"fix/multiagent-safety-indexing-windows","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":18,"untracked":null,"untracked_normal":8},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},"push_remote":"origin","remotes":[{"name":"entireio","host":"github.com","remote":"entireio/entire-brain","visibility":"p