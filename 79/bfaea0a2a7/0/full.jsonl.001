\":\"query\",\"type\":\"string\"}},\"required\":[\"query\"],\"type\":\"object\"},\"name\":\"brain_review\"}","+{\"description\":\"Diff-less review (versioned schema_version contract) of the current working tree against brain memory, not a branch/base diff. Returns severity-ranked suspected regressions with provenance. Use instead of re-reading your own changes to catch a silently reverted decision. Not for style, build errors or anything memory never recorded \\u2014 read the diff for those.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"include_deletions\":{\"description\":\"Also flag deleted assignments (lower confidence, noisier)\",\"title\":\"include_deletions\",\"type\":\"boolean\"},\"limit\":{\"description\":\"Maximum findings (removable rows may be trimmed with response_truncated; otherwise errors)\",\"maximum\":10000,\"minimum\":1,\"title\":\"limit\",\"type\":\"integer\"},\"location_only\":{\"description\":\"Return only the suspected file:line, not the expected/current values\",\"title\":\"location_only\",\"type\":\"boolean\"},\"query\":{\"description\":\"What to review plus the relevant symbols/identifiers\",\"maxLength\":8192,\"title\":\"query\",\"type\":\"string\"}},\"required\":[\"query\"],\"type\":\"object\"},\"name\":\"brain_review\"}"]}]},{"filePath":"/Users/suhaan/devenv/brain-v1-guide/internal/cli/testdata/mcp_brain_workspace_review_tool.golden.json","hunks":[{"oldStart":1,"oldLines":1,"newStart":1,"newLines":1,"lines":["-{\"description\":\"Cross-repo diff-less review (versioned contract) of each local workspace repo's current tree against its brain memory. Returns severity-ranked suspected regressions per repo. Allows registered sibling checkouts when the bound repo is a workspace member; other workspaces need ENTIRE_BRAIN_MCP_ALLOW_CROSS_REPO.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"include_deletions\":{\"description\":\"Also flag deleted assignments (lower confidence, noisier)\",\"title\":\"include_deletions\",\"type\":\"boolean\"},\"limit\":{\"description\":\"Maximum findings per repo (removable rows may be trimmed with response_truncated; otherwise errors)\",\"maximum\":10000,\"minimum\":1,\"title\":\"limit\",\"type\":\"integer\"},\"location_only\":{\"description\":\"Return only the suspected file:line, not the expected/current values\",\"title\":\"location_only\",\"type\":\"boolean\"},\"query\":{\"description\":\"What to review plus the relevant symbols/identifiers\",\"maxLength\":8192,\"title\":\"query\",\"type\":\"string\"},\"workspace\":{\"description\":\"Workspace name\",\"maxLength\":8192,\"title\":\"workspace\",\"type\":\"string\"}},\"required\":[\"workspace\",\"query\"],\"type\":\"object\"},\"name\":\"brain_workspace_review\"}","+{\"description\":\"Cross-repo diff-less review (versioned contract) of each local workspace repo's current tree against its brain memory, severity-ranked per repo. Use instead of re-reading your changes in each sibling checkout. Not for style or build errors, and not for repos outside the workspace \\u2014 registered siblings are allowed when the bound repo is a member; other workspaces need ENTIRE_BRAIN_MCP_ALLOW_CROSS_REPO.\",\"inputSchema\":{\"additionalProperties\":false,\"properties\":{\"include_deletions\":{\"description\":\"Also flag deleted assignments (lower confidence, noisier)\",\"title\":\"include_deletions\",\"type\":\"boolean\"},\"limit\":{\"description\":\"Maximum findings per repo (removable rows may be trimmed with response_truncated; otherwise errors)\",\"maximum\":10000,\"minimum\":1,\"title\":\"limit\",\"type\":\"integer\"},\"location_only\":{\"description\":\"Return only the suspected file:line, not the expected/current values\",\"title\":\"location_only\",\"type\":\"boolean\"},\"query\":{\"description\":\"What to review plus the relevant symbols/identifiers\",\"maxLength\":8192,\"title\":\"query\",\"type\":\"string\"},\"workspace\":{\"description\":\"Workspace name\",\"maxLength\":8192,\"title\":\"workspace\",\"type\":\"string\"}},\"required\":[\"workspace\",\"query\"],\"type\":\"object\"},\"name\":\"brain_workspace_review\"}"]}]}],"moreFiles":0,"changedFiles":["/Users/suhaan/devenv/brain-v1-guide/internal/cli/testdata/mcp_brain_review_tool.golden.json","/Users/suhaan/devenv/brain-v1-guide/internal/cli/testdata/mcp_brain_workspace_review_tool.golden.json"]}},"serverClassifierContext":{"request":"21deb2b0-99f8-45f1-a859-747a6b5db380","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-v1-guide","root":"/Users/suhaan/devenv/brain-v1-guide","branch":"fix/agent-guide-directive-and-discovery","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},"push_remote":"origin","remotes":[{"name":"entireio","host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"name":"origin","host":"github.com","remote":"entireio/entire-brain","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"host":"github.com","remote":"entireio/entire-graph","visibility":"public"}]}},"live_cwd":"/Users/suhaan/devenv/brain-v1-guide","platform":"macos"}},"sourceToolAssistantUUID":"563f4ec8-1469-44ed-b178-26691f6ee50f","session_id":"6ca2c8fb-c97b-4bf3-a992-0e3c6d1967e2","sessionKind":"bg","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/brain-v1-guide","sessionId":"6ca2c8fb-c97b-4bf3-a992-0e3c6d1967e2","version":"2.1.288","gitBranch":"main","slug":"dynamic-petting-globe"}
