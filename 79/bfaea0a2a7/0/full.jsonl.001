2026-10-05 mcp=4   bash=4    ans=5    empty=1   fail=2   top=[('recall', 3), ('inspect', 1), ('get', 1), ('status', 1)]\n  2026-10-06 mcp=0   bash=9    ans=8    empty=0   fail=1   top=[('remember', 2), ('refresh', 2), ('doctor', 2), ('setup', 2)]\n  2026-10-10 mcp=0   bash=2    ans=2    empty=0   fail=0   top=[('mcp', 2)]\n  2026-10-11 mcp=0   bash=20   ans=17   empty=3   fail=0   top=[('path', 7), ('memory', 4), ('bundle', 3), ('setup', 2)]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"/Users/suhaan/devenv/.claude/mods/brain-memory/scripts/collect-usage.py","hunks":[{"oldStart":1,"oldLines":81,"newStart":1,"newLines":162,"lines":[" #!/usr/bin/env python3","-\"\"\"Extract brain usage per day from Claude Code transcripts.","+\"\"\"Extract per-day Entire Brain usage from Claude Code transcripts."," "," Both routes count: the MCP tools (mcp__entire-brain__*) and the CLI through","-Bash (`entire brain …` / `entire-brain …`). Only lines that already contain a","-marker are JSON-parsed, because the transcript corpus is gigabytes and parsing","-every line would dominate the runtime.","+Bash (`entire brain <verb>`). Only lines that already contain a marker are","+JSON-parsed -- the transcript corpus is gigabytes and parsing every line would","+dominate the runtime."," ","-A file whose mtime predates the window cannot contain events inside it, so the","-mtime filter is sound for bounding the scan — but a file written TODAY may hold","-months of history, so every matching line is still date-checked individually.","+Two things that are easy to get wrong here, both found by running it:","+","+1. `entire-brain` also appears as a DIRECTORY (~/devenv/entire-brain), so a","+   naive \"word after the match\" grabs the next shell word and reports verbs","+   like `echo` and `git`. Hence the allowlist: a token only counts when it is","+   a verb the binary actually registers.","+2. A file's mtime bounds the scan safely (a file last written before the window","+   cannot hold events inside it), but a file written today may carry months of","+   history -- so every matching line is still date-checked on its own timestamp.","+","+Empty answers are the point of this view, not a footnote: an empty result that","+nobody notices is how a brain quietly stops being consulted while everyone","+still believes it works. Results are paired back to their call by tool_use id."," \"\"\""," import json, os, re, sys, time, glob"," from collections import defaultdict"," "," DAYS = int(sys.argv[1]) if len(sys.argv) > 1 else 31"," ROOT = os.path.expanduser(\"~/.claude/projects\")","+","+VERBS = {","+    \"add\",\"agent-guide\",\"bench\",\"brief\",\"bundle\",\"capabilities\",\"config\",\"dash\",","+    \"distill\",\"doctor\",\"entities\",\"facts\",\"gc\",\"get\",\"init-agents\",\"inspect\",","+    \"mcp\",\"memory\",\"multi-get\",\"overview\",\"path\",\"patterns\",\"privacy\",\"publish\",","+    \"query\",\"recall\",\"refresh\",\"remember\",\"repair\",\"repo-identity\",\"reset\",","+    \"setup\",\"show\",\"stats\",\"status\",\"verify\",\"version\",\"viz\",\"watch\",\"workspace\",","+}","+"," now = time.time()","-cutoff_ts = now - DAYS * 86400","-# a little slack: a session file can be appended to after its events","-MARKERS = (b\"entire-brain\", b\"entire brain\")","+window_start = time.strftime(\"%Y-%m-%d\", time.localtime(now - (DAYS - 1) * 86400))","+MARK_CALL = (b\"entire-brain\", b\"entire brain\")"," MCP_RE = re.compile(r\"mcp__entire-brain__([a-z_]+)\")","-BASH_RE = re.compile(r\"\\bentire(?:-brain| brain)\\s+([a-z][a-z-]*)\")","+# `entire` as a COMMAND, not as a path segment: reject a preceding / or word char.","+BASH_RE = re.compile(r\"(?<![\\w/.-])entire(?:-brain|\\s+brain)\\s+([a-z][a-z-]*)\")"," ","-days = defaultdict(lambda: {\"mcp\": 0, \"bash\": 0, \"empty\": 0, \"tools\": defaultdict(int)})","+days = defaultdict(lambda: {\"mcp\": 0, \"bash\": 0, \"answered\": 0, \"empty\": 0,","+                            \"failed\": 0, \"tools\": defaultdict(int)})"," scanned = matched = 0"," ","+","+def classify(payload: str):","+    \"\"\"answered | empty | unknown, from a brain reply body.\"\"\"","+    try:","+        obj = json.loads(payload)","+    except Exception:","+        low = payload.lower()","+        if \"no facts for\" in low or \"nothing matched\" in low or \"no results\" in low:","+            return \"empty\"","+        return \"answered\" if payload.strip() else \"empty\"","+    if isinstance(obj, dict):","+        if obj.get(\"blind_spot\"):","+            return \"empty\"","+        for key in (\"results\", \"facts\", \"items\", \"records\", \"matches\"):","+            val = obj.get(key)","+            if isinstance(val, list):","+                return \"answered\" if val else \"empty\"","+        if obj.get(\"missing\"):","+            return \"empty\"","+    if isinstance(obj, list):","+        return \"answered\" if obj else \"empty\"","+    return \"answered\"","+","+","+def payload_text(c):","+    content = c.get(\"content\")","+    if isinstance(content, str):","+        return content","+    if isinstance(content, list):","+        return \"\".join(p.get(\"text\", \"\") for p in content","+                       if isinstance(p, dict) and p.get(\"type\") == \"text\")","+    if isinstance(content, dict):","+        return content.get(\"stdout\") or content.get(\"text\") or \"\"","+    return \"\"","+","+"," for path in glob.glob(os.path.join(ROOT, \"*\", \"*.jsonl\")):","     try:","-        if os.path.getmtime(path) < cutoff_ts:","+        if os.path.getmtime(path) < now - DAYS * 86400:","             continue","     except OSError:","         continue","     scanned += 1","+    pending = {}          # tool_use id -> (day, verb)","     try:","         with open(path, \"rb\") as fh:","             for raw in fh:","-                if not any(m in raw for m in MARKERS):","+                has_mark = any(m in raw for m in MARK_CALL)","+                hit_id = None","+                if pending and b'\"tool_use_id\"' in raw:","+                    for tid in pending:","+                        if tid.encode() in raw:","+                            hit_id = tid","+                            break","+                if not has_mark and hit_id is None:","                     continue","                 try:","                     obj = json.loads(raw)","                 except Exception:","                     continue","                 ts = obj.get(\"timestamp\")","-                if not isinstance(ts, str) or len(ts) < 10:","+                if not isinstance(ts, str) or len(ts) < 10 or ts[:10] < window_start:","                     continue","                 day = ts[:10]","-                msg = obj.get(\"message\") or {}","-                content = msg.get(\"content\")","+                content = (obj.get(\"message\") or {}).get(\"content\")","                 if not isinstance(content, list):","                     continue","                 for c in content:","-                    if not isinstance(c, dict) or c.get(\"type\") != \"tool_use\":","+                    if not isinstance(c, dict):","                         continue","-                    name = c.get(\"name\") or \"\"","-                    inp = c.get(\"input\") or {}","-                    m = MCP_RE.search(name)","-                    if m:","-                        days[day][\"mcp\"] += 1","-                        days[day][\"tools\"][m.group(1)] += 1","-                        matched += 1","-                    elif name == \"Bash\":","-                        cmd = str(inp.get(\"command\") or \"\")","-                        bm = BASH_RE.search(cmd)","-                        if bm:","-                            days[day][\"bash\"] += 1","-                            days[day][\"tools\"][bm.group(1)] += 1","+                    kind = c.get(\"type\")","+                    if kind == \"tool_use\":","+                        name = c.get(\"name\") or \"\"","+                        m = MCP_RE.search(name)","+                        verb = None","+                        route = None","+                        if m:","+                            verb, route = m.group(1).replace(\"brain_\", \"\"), \"mcp\"","+                        elif name == \"Bash\":","+                            bm = BASH_RE.search(str((c.get(\"input\") or {}).get(\"command\") or \"\"))","+                            if bm and bm.group(1) in VERBS:","+                                verb, route = bm.group(1), \"bash\"","+                        if verb:","+                            days[day][route] += 1","+                            days[day][\"tools\"][verb] += 1","                             matched += 1","+                            if c.get(\"id\"):","+                                pending[c[\"id\"]] = (day, verb)","+                                if len(pending) > 400:","+                                    pending.pop(next(iter(pending)))","+                    elif kind == \"tool_result\":","+                        tid = c.get(\"tool_use_id\")","+                        if tid not in pending:","+                            continue","+                        d, _verb = pending.pop(tid)","+                        if c.get(\"is_error\"):","+                            days[d][\"failed\"] += 1","+                        else:","+                            days[d][classify(payload_text(c))","+                                     if classify(payload_text(c)) != \"unknown\"","+                                     else \"answered\"] += 1","     except OSError:","         continue"," ","-out = {","+json.dump({","     \"generated_at\": time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime()),","     \"window_days\": DAYS,","+    \"window_start\": window_start,","     \"files_scanned\": scanned,","     \"events\": matched,","-    \"days\": {d: {\"mcp\": v[\"mcp\"], \"bash\": v[\"bash\"], \"empty\": v[\"empty\"],","+    \"days\": {d: {\"mcp\": v[\"mcp\"], \"bash\": v[\"bash\"], \"answered\": v[\"answered\"],","+                 \"empty\": v[\"empty\"], \"failed\": v[\"failed\"],","                  \"tools\": dict(sorted(v[\"tools\"].items(), key=lambda kv: -kv[1]))}","              for d, v in sorted(days.items())},","-}","-json.dump(out, sys.stdout, indent=1)","+}, sys.stdout, indent=1)"]}]}],"moreFiles":0,"changedFiles":["/Users/suhaan/devenv/.claude/mods/brain-memory/scripts/collect-usage.py"]}},"serverClassifierContext":{"request":"8fb84dbf-1f36-4463-8a85-12d7f638190c","context":{"git_state":{"cwd":"/Users/suhaan/devenv","root":"/Users/suhaan/devenv","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":252},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"entirehq/devenv","visibility":"private"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"host":"github.com","remote":"entirehq/entire-api","visibility":"private"}]}},"live_cwd":"/Users/suhaan/devenv","platform":"macos"}},"sourceToolAssistantUUID":"40a56a50-153b-4f33-b0a0-54a37c5855a3","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"1eac9040-9610-45f1-aa43-df0931455a37","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv","sessionId":"6ca2c8fb-c97b-4bf3-a992-0e3c6d1967e2","version":"2.1.296","gitBranch":"main","slug":"dynamic-petting-globe"}
