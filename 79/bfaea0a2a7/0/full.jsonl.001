le: 'Brain memory' }])\n})\n\n// Brain payloads are large -- one real `query` here is 39 KB over 103 lines --\n// and Claude Code truncates long Bash output, so the JSON a hook receives often\n// does not parse. Counting lines instead turns every truncated answer into a\n// hit. Caught by running the mod for real, not by any test above.\nconst truncate = (json: string, lines: number) => json.split('\\n').slice(0, lines).join('\\n')","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"a8304cb2-81b4-4df5-b4cb-a50ae99a8ee6","context":{"git_state":{"cwd":"/Users/suhaan/devenv/.claude/mods/brain-memory","root":"/Users/suhaan/devenv","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":252},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"entirehq/devenv","visibility":"private"}],"visibility_cache":[{"host":"github.com","remote":"entirehq/devenv","visibility":"private"},{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},{"host":"github.com","remote":"entirehq/entire-api","visibility":"private"}]}},"live_cwd":"/Users/suhaan/devenv/.claude/mods/brain-memory","platform":"macos"}},"sourceToolAssistantUUID":"ae87fdcb-b9ca-49c9-bcd6-427c659f43d8","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"1eac9040-9610-45f1-aa43-df0931455a37","userType":"external","entrypoint":"cli","cwd":"/Users/suhaan/devenv/.claude/mods/brain-memory","sessionId":"6ca2c8fb-c97b-4bf3-a992-0e3c6d1967e2","version":"2.1.296","gitBranch":"main","slug":"dynamic-petting-globe"}
