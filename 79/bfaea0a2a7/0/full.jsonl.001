\t\tif !strings.Contains(note, want) {","+\t\t\tt.Errorf(\"the note must contain %q so the facts are reachable; got: %s\", want, note)","+\t\t}","+\t}","+}","+","+// On the branch that HOLDS the facts, an empty result means the query missed —","+// not that the caller is on the wrong branch. Saying otherwise would send them","+// chasing a branch they are already on.","+func TestBriefStaysQuietWhenTheCurrentBranchIsTheOneWithFacts(t *testing.T) {","+\tt.Parallel()","+","+\tf := newVerifyFixture(t)","+\tif err := writeFacts(f.brainDir, \"main\", []factRecord{","+\t\tvitalityTestFact(\"retries are capped at three\", \"main\", f.now),","+\t}); err != nil {","+\t\tt.Fatal(err)","+\t}","+\tif note := briefBranchBlindSpot(f.brainDir, \"main\"); note != \"\" {","+\t\tt.Fatalf(\"no other branch holds facts, so there is nothing to point at; got: %s\", note)","+\t}","+}","+","+// A brain with no facts anywhere is a different problem with a different","+// remedy (distill), already covered by emptyResultBlindSpot. This note must","+// not fire there and claim a branch would help.","+func TestBriefStaysQuietWhenNoBranchHasFacts(t *testing.T) {","+\tt.Parallel()","+","+\tf := newVerifyFixture(t)","+\tif note := briefBranchBlindSpot(f.brainDir, \"main\"); note != \"\" {","+\t\tt.Fatalf(\"an empty brain is not a branch problem; got: %s\", note)","+\t}","+}"]}],"created":true}],"moreFiles":0,"changedFiles":["/Users/suhaan/devenv/brain-v1-guide/internal/cli/brief_branch_blindspot_test.go"]}},"serverClassifierContext":{"request":"b386e810-0695-4b69-b64d-0d10ba5d5119","context":{"git_state":{"cwd":"/Users/suhaan/devenv/brain-v1-guide","root":"/Users/suhaan/devenv/brain-v1-guide","branch":"fix/agent-guide-directive-and-discovery","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":6,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"entireio/entire-brain","visibility":"public"},"pu